# ==========================================
# WACRM / LA FLEUR CLINIC ENVIRONMENT VARIABLES
# ==========================================

# Production Site URL (Your Hostinger domain, e.g. https://yourclinicdomain.com)
NEXT_PUBLIC_SITE_URL=https://yourclinicdomain.com

# Supabase Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Node Environment & Port (Hostinger automatically provides PORT)
NODE_ENV=production
PORT=3000

# Emergency Doctor WhatsApp Relay
DOCTOR_EMERGENCY_PHONE=+919876543210

# AI Provider Configuration (Gemini / OpenAI / Groq)
DEFAULT_AI_PROVIDER=gemini
DEFAULT_AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Meta WhatsApp Business Cloud API (Configurable in Settings or via env)
# WHATSAPP_API_TOKEN=your_meta_token
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

